{
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node16",
		"lib": [
			"ES2020"
		],
		"outDir": "dist/electron",
		"rootDir": "electron",
		"moduleResolution": "node16",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true
	},
	"include": [
		"electron/**/*"
	]
}
