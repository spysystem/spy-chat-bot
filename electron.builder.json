{
	"appId": "com.spysystem.support-claude",
	"productName": "Spørge Jørgen",
	"directories": {
		"output": "release"
	},
	"files": [
		"dist/**/*",
		"package.json"
	],
	"publish": [
		{
			"provider": "github",
			"owner": "spysystem",
			"repo": "spy-chat-bot",
			"releaseType": "release"
		}
	],
	"win": {
		"target": [
			"nsis"
		],
		"icon": "build/icon.ico"
	},
	"mac": {
		"target": [
			"dmg"
		],
		"icon": "build/icon.icns"
	},
	"linux": {
		"target": [
			"AppImage"
		],
		"icon": "build/icon.png"
	}
}
