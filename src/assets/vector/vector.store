{"id":"697a20e78baf2","content":"{\"questions\":\"Find orders where all styles are cancelled (completely cancelled orders)\",\"answer\":\"\\t\\tSELECT\\n\\t\\t\\ts_order_main.id AS iSOrderID,\\n\\t\\t\\ts_order_main.order_no AS strOrderNo,\\n\\t\\t\\ts_order_main.status AS strStatus,\\n\\t\\t\\tcustomers.company AS strCustomerName,\\n\\t\\t\\ts_order_main.added_date AS dtAddedDate\\n\\t\\tFROM s_order_main\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tWHERE NOT EXISTS (\\n\\t\\t\\tSELECT 1\\n\\t\\t\\tFROM s_order_styles\\n\\t\\t\\tWHERE s_order_styles.s_order_main_id = s_order_main.id\\n\\t\\t\\t\\t&& s_order_styles.cancel = 0\\n\\t\\t)\\n\\t\\t&& EXISTS (\\n\\t\\t\\tSELECT 1\\n\\t\\t\\tFROM s_order_styles\\n\\t\\t\\tWHERE s_order_styles.s_order_main_id = s_order_main.id\\n\\t\\t)\\n\\t\\tORDER BY s_order_main.added_date DESC;\"}","embedding":[-0.037368298,-0.00938034,-0.02361484,0.06301664,0.015622966,-0.0069423257,0.0024544129,0.01540431,-0.050684445,0.018509224,0.024992373,-0.034963083,0.014289165,-0.013950248,-0.0482355,0.036209423,-0.044409018,0.030393174,-0.020039815,-0.026610427,0.039379932,0.04687983,0.043687455,-0.0073359064,0.052083842,0.06052396,-0.04757953,-0.009309276,0.010807069,-0.03675606,-0.007576428,0.000454736,0.048104305,-0.009101553,-0.047054756,-0.021625072,0.020783246,-0.01188395,-0.006641674,0.005613991,-0.029824669,-0.016902104,0.009353007,0.04042948,-0.04569909,0.021165894,-0.01989769,0.009609928,-0.028075421,-0.039205007,0.012124471,0.023461781,-0.037783746,-0.0045207115,0.025276626,0.00073454727,-0.032514136,-0.029933996,0.044737004,0.02416148,-0.071631685,-0.009883248,0.0044523813,0.057331584,-0.040167093,0.04237552,-0.014201703,0.043949842,-0.009276478,0.0007174648,-0.0040396685,-0.034263384,0.022696486,0.057287853,-0.02619498,0.0071555153,0.026216846,0.0036597536,0.019515041,0.022696486,0.022980738,0.022630889,-0.026326174,0.0112607805,-0.016410127,0.03944553,-0.041500896,-0.11615003,-0.0019269054,0.00