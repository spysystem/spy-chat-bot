{"id":"697a20e22d3c6","content":"{\"questions\":\"Find orders with pending deliveries (not fully delivered)\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_main.id AS iSOMainID,\\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\tcustomers.company AS strCustomerName,\\n\\t\\t\\tSUM(s_order_styles.so_qty) AS iTotalOrderedQty,\\n\\t\\t\\tSUM(s_order_styles.so_delivered_qty) AS iTotalDeliveredQty,\\n\\t\\t\\tSUM(s_order_styles.so_qty - s_order_styles.so_delivered_qty) AS iPendingQty\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_styles.s_order_main_id\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tWHERE s_order_styles.cancel = 0\\n\\t\\t\\t&& s_order_main.status = 'order'\\n\\t\\tGROUP BY s_order_main.id, s_order_main.order_no, customers.company\\n\\t\\tHAVING iPendingQty > 0\\n\\t\\tORDER BY iPendingQty DESC;\"}","embedding":[-0.03958979,0.006029864,-0.015648667,0.06656256,0.030026715,-0.0057567926,0.03958979,0.03747209,-0.0424654,0.01596075,0.050601814,-0.048863076,-0.012806495,0.01036557,-0.089344524,0.0530093,-0.032032955,0.043111853,-0.024721328,-0.048015997,0.0030232912,0.051359728,0.036290642,-0.0006070964,0.05399013,0.019025836,-0.01316316,0.0066596,0.0046645068,-0.017108763,-0.013687011,0.035176065,0.049576405,-0.058938853,-0.03671418,-0.014043676,-0.04291123,-0.019505106,0.019538542,-0.0016760458,-0.038809586,-0.028198808,-0.012505558,0.018925525,-0.04837266,-0.01907042,-0.017978134,0.023517584,-0.025791321,-0.04117249,0.013898781,0.0018669172,-0.06464549,0.0065927254,-0.0062416336,-0.012817641,0.0016231034,-0.01980604,0.03368253,-0.021032076,-0.053053886,-0.032055248,0.010911713,0.040682077,-0.010644214,0.034061488,-0.028109644,0.027374022,0.023316959,0.00978599,0.014913046,-0.032857742,0.012483267,0.10236279,-0.004040343,-0.003825787,0.036290642,-0.030138174,0.06402133,0.0059685623,0.0017234153,0.041350823,-0.021377595,-0.009267711,0.0056871315,0.024297789,-0.06660715,-0.1227818