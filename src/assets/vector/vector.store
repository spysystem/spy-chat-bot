{"id":"697a20e37707b","content":"{\"questions\":\"Find styles with discount on orders\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\ts_order_styles.sales_price_original AS fOriginalPrice,\\n\\t\\t\\ts_order_styles.sales_price AS fActualPrice,\\n\\t\\t\\ts_order_styles.sales_discount_percentage AS fDiscountPct,\\n\\t\\t\\ts_order_styles.sales_price_discount_amt AS fDiscountAmount,\\n\\t\\t\\ts_order_styles.so_qty AS iQty\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_styles.s_order_main_id\\n\\t\\tINNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\tWHERE s_order_styles.sales_discount_percentage > 0\\n\\t\\t\\t&& s_order_styles.cancel = 0\\n\\t\\t\\t&& s_order_main.status = 'order'\\n\\t\\tORDER BY s_order_styles.sales_discount_percentage DESC\\n\\t\\tLIMIT 50;\"}","embedding":[-0.051353656,0.015898347,-0.013603398,0.0670081,0.02348166,-0.014734242,0.027317662,0.03700745,-0.04651985,0.072994925,0.031530615,-0.071309745,0.0299563,0.00878622,-0.03390317,0.035433136,-0.026829846,0.043969907,-0.005765091,-0.022561463,0.0041990927,0.031552788,0.013071235,0.014579029,0.0011273802,0.05303884,-0.031198012,0.007056693,0.03552183,-0.0132264495,0.0026871422,0.008919261,0.04261733,-0.04567726,-0.064790756,-0.0046203877,0.02549944,0.014479248,0.017084626,0.037717,-0.014689895,-0.040643893,0.010670962,0.0045455527,-0.021364097,0.009623268,0.013658831,0.009700875,-0.012295165,-0.07649832,0.034967493,0.049845863,-0.03667485,0.005981282,-0.037140492,-0.019390661,-0.008730787,0.020000432,0.02918023,-0.002594291,-0.04470163,-0.022506028,0.011020193,0.031153666,-0.042151686,0.025055973,-0.031619307,0.07370447,-0.0011329235,0.050688453,-0.011984738,-0.010676505,0.039180446,0.08417033,-0.011474748,0.014035779,0.012782981,-0.033082753,0.001671322,0.022572549,0.029268924,0.03281667,-0.038847845,-0.0044263704,0.013736438,0.038315684,-0.03494532,-0.12310687,-