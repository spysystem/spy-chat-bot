{"id":"697a20e5ef123","content":"{\"questions\":\"Get orders with total quantities from order styles\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_main.id AS iSOMainID,\\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\ts_order_main.status AS strOrderStatus,\\n\\t\\t\\tcustomers.company AS strCustomerName,\\n\\t\\t\\tSUM(s_order_styles.so_qty) AS iTotalQty\\n\\t\\tFROM s_order_main\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tINNER JOIN s_order_styles ON s_order_styles.s_order_main_id = s_order_main.id\\n\\t\\tWHERE s_order_main.status = 'order'\\n\\t\\t\\t&& s_order_styles.cancel = 0\\n\\t\\tGROUP BY s_order_main.id, s_order_main.order_no, s_order_main.status, customers.company\\n\\t\\tORDER BY iTotalQty DESC\\n\\t\\tLIMIT 20;\"}","embedding":[-0.052716102,-0.0070976326,-0.019051822,0.054256506,0.04385877,-0.014184568,0.024197204,0.045570333,-0.066793695,0.03483028,0.018677417,-0.005017015,0.03624232,0.02573761,-0.041612346,0.039045002,-0.031449948,0.03600698,-0.03170668,-0.0138850445,0.026251078,0.07081587,0.02503159,0.050662227,0.022357276,0.021159181,-0.013425062,0.0018974267,0.018089067,-0.0019870163,-0.011884657,0.012569281,0.035600483,-0.06675091,-0.041377004,-0.014259448,-0.007322275,-0.026743151,0.0057123373,0.0058407043,0.006038604,-0.009049883,0.029310495,0.012943686,-0.04505686,-0.0017931283,-0.0073864586,0.027513355,-0.011841868,-0.044457816,0.031150423,0.012815318,-0.053101204,0.029866753,-0.0073436694,-0.021116393,0.017682573,-0.001704876,0.039857995,-0.0040087984,-0.038959425,-0.029567229,-0.0058727963,0.01636681,-0.050191548,0.018153252,-0.020271309,0.083994895,0.04056401,0.035664666,0.0007033449,-0.014120384,0.054812763,0.104576424,-0.004605171,0.021276852,0.07201396,-0.056010857,0.017875124,0.058449835,-0.020688502,0.036178134,-0.029888147,0.010124957,0.017233288,0.020988027,-0.08365258,-0.11150825,-0.021972174,-0.024582306,0.01644169,-0.031043451,0.0363279,-0.007611101,0.045270808,0.034423787,-0.02449672