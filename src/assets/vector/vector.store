{"id":"697a21078d410","content":"{\"type\":\"data_access_pattern\",\"pattern\":\"Get Sales Order Data\",\"description\":\"How to retrieve sales orders and order lines\",\"entity\":\"SOrder\",\"table\":\"s_order_main\",\"access_methods\":[\"SOrder::Get($iOrderID) - Get order by ID\",\"SOrderCollection::Get()->withCustomerID($iCustomerID) - Orders for customer\",\"SOrderCollection::Get()->withBrandID($iBrandID) - Orders for brand\",\"SOrderCollection::Get()->withStatus(\\\"running\\\") - Orders by status\",\"$oOrder->getStyles() - Get order lines\\\/styles\",\"$oOrder->getDeliveries() - Get delivery info\"],\"order_statuses\":[\"running - Active orders\",\"paused - Temporarily paused\",\"cancelled - Cancelled orders\",\"closed - Completed orders\"],\"related_entities\":[\"SOrderStyle - Order line items (styles on order)\",\"SOStyleColor - Color details per order line\",\"Customer - The customer who placed the order\"],\"search_terms\":[\"sales order\",\"order data\",\"order lines\",\"order status\"]}","embedding":[-0.0502584,0.040440675,-0.011854381,0.056316145,0.03319227,-0.030226063,-0.005822747,0.006334522,-0.047417525,0.033610046,0.04257133,-0.014047704,0.04154778,0.012272158,-0.004668642,0.06450455,-0.017901683,-0.0031881498,0.0040628673,-0.024481649,-0.00080225966,0.034299374,0.003650314,0.012460156,0.011238162,0.0068932967,-0.0040054233,0.03043495,-0.03026784,0.020794779,0.002484459,0.001073161,0.047626413,-0.056023702,-0.028910069,-0.020544114,-0.028074518,0.0074520716,0.020544114,-0.06638454,-0.0049193073,-0.017818129,0.013222597,0.028158072,-0.04357399,0.059700128,-0.008339845,0.00023238765,0.0027520966,-0.026925635,0.017818129,-0.075659156,-0.04662375,-0.010862165,0.0029662065,-0.047626413,0.053976603,0.048336633,-0.0028513183,-0.021316998,-0.0755756,-0.026612304,0.021243887,0.07256762,-0.025003867,0.013400151,0.024794979,0.06780498,0.055188153,0.030748282,-0.007378961,0.041798446,0.026090084,0.090072416,-0.0071021845,0.037035804,0.09207773,-0.031709164,0.0