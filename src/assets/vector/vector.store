{"id":"697a20e1ed157","content":"{\"questions\":\"Get order lines with delivery status (ordered vs delivered)\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\ts_order_styles.so_qty AS iOrderedQty,\\n\\t\\t\\ts_order_styles.so_delivered_qty AS iDeliveredQty,\\n\\t\\t\\t(s_order_styles.so_qty - s_order_styles.so_delivered_qty) AS iRemainingQty,\\n\\t\\t\\ts_order_styles.status AS strStatus\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_styles.s_order_main_id\\n\\t\\tINNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\tWHERE s_order_main.id = 123\\n\\t\\t\\t&& s_order_styles.cancel = 0\\n\\t\\tORDER BY styles.sStyleNo;\"}","embedding":[-0.03143509,0.017473575,-0.01730014,0.073926665,0.023999067,0.0025825554,0.036898296,0.042448215,-0.030069292,0.032172192,0.0055146907,-0.043879054,0.00032434377,0.0036746538,-0.06577522,0.045960274,-0.02495296,0.04578684,-0.047087602,-0.051163323,0.057190187,0.05575935,0.01108358,0.03225891,0.032388985,0.0150129665,0.019294644,0.0035554173,0.015912661,-0.04543997,-0.019695712,0.03910959,0.053938285,-0.04123417,-0.053201184,-0.006709766,0.0029754941,-0.032302268,0.022654945,0.00017106382,-0.04010684,-0.022438152,0.0054523624,0.050296146,-0.0639108,0.008828925,-0.018275712,0.009056559,-0.012172968,-0.060051866,-0.0011185202,-0.019966703,-0.04752119,0.0064550336,0.0046854545,-0.02183113,0.030242726,0.014460143,0.036139518,-0.0073980866,-0.072279036,-0.036529746,0.018850217,0.046263784,-0.03464364,0.031044863,-0.010920985,0.057276905,0.026058607,0.016823195,0.0014457433,-0.010454878,0.03904455,0.06356393,-0.00658511,0.022980137,0.04400913,-0.02495296,0.038155697,0.03013433,0.012845029,0.025559982,-0.04609035,-0.006303278,-0.023803953,0.022329755,-0.048648514,-0.11741549,-0.030936467,0.0055932784,-0.0021882618,-0.02597189,0.036659822,-0.004907668,0.033147763,0.030914787,-0.022264717,0.0039591957,0.017896323,0.