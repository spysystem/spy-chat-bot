{"id":"697a20db98385","content":"{\"questions\":\"Find unprocessed pending consignments (without related order)\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_consignment_pending.id AS iPendingConsignmentID,\\n\\t\\t\\ts_order_consignment_pending.type AS strType,\\n\\t\\t\\ts_order_consignment_pending.qty AS iQty,\\n\\t\\t\\ts_order_consignment_pending.date AS dtConsignmentDate,\\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\tcustomers.company AS strCustomerName\\n\\t\\tFROM s_order_consignment_pending\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_consignment_pending.s_order_main_id\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tWHERE s_order_consignment_pending.related_s_order_main_id = 0\\n\\t\\t\\t&& s_order_consignment_pending.is_deleted = 0\\n\\t\\tORDER BY s_order_consignment_pending.added_date DESC;\"}","embedding":[-0.0023613502,0.042092826,-0.020780945,0.047487166,0.020717232,0.0033475691,0.022172004,0.03990536,-0.024890412,-0.0024224082,0.056449413,-0.054283183,-0.026929216,0.012445206,-0.04969587,0.05908287,-0.0024768296,0.050375473,-0.026419515,-0.0626083,0.013868121,0.05343368,0.06451968,-0.038142644,0.037611704,0.0077782534,-0.022596756,0.00537841,-0.012243449,0.01579012,-0.0074915467,0.04062744,0.033342957,-0.032068703,-0.021832203,0.00885075,-0.03115549,-0.017988207,0.011988598,-0.031176725,-0.0033714613,-0.028522031,-0.046467762,0.0013280107,-0.037335616,0.0021051723,0.016490959,-0.012583249,-0.022108292,0.018805852,0.01171251,-0.019230604,-0.07161303,-0.033279244,-0.022957794,-0.00093511597,0.0037962124,-0.037059527,0.045490835,0.018020064,-0.061886225,-0.047232315,-0.01362389,0.033024393,0.0004768494,0.040054023,-0.018593477,0.034723397,0.04319718,-0.016246727,-0.04224149,-0.034829587,0.027651293,0.13158788,0.02654694,-0.008096817,0.032132417,0.001644583,0.07942844,0.010050671,0.019071322,0.037420567,0.002284364,0.013071713,0.017935112,0.011393947,-0.052796554,-0.11960989,-0.024529373,-0.00