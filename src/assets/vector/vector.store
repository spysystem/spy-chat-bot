{"id":"697a20ebebd34","content":"{\"questions\":\"Check mail delivery status for newsletters\",\"answer\":\"\\t\\tSELECT\\n\\t\\t\\tmaillog.subject AS strSubject,\\n\\t\\t\\tmaillog.added_date AS dtAddedDate,\\n\\t\\t\\tCOUNT(maillog_receivers.id) AS iTotalRecipients,\\n\\t\\t\\tSUM(maillog_receivers.is_sent) AS iSentCount,\\n\\t\\t\\tSUM(maillog_receivers.is_opened) AS iOpenedCount\\n\\t\\tFROM maillog\\n\\t\\tINNER JOIN maillog_receivers ON maillog_receivers.maillog_id = maillog.id\\n\\t\\tWHERE maillog.type = 'newsletter_received'\\n\\t\\tGROUP BY maillog.id, maillog.subject, maillog.added_date\\n\\t\\tORDER BY maillog.added_date DESC\\n\\t\\tLIMIT 20;\"}","embedding":[-0.017997703,-0.0052643553,-0.016762888,0.046289172,0.023778386,-0.0175606,0.010692624,0.058222078,-0.026379146,0.05844063,0.0604513,-0.07946527,-0.051141012,0.0025379274,-0.0351212,0.015659204,-0.045502387,0.017593382,-0.003103429,0.003384814,0.03485894,0.03529604,0.03461853,0.057304163,-0.019702403,0.009261113,0.026685119,-0.023253862,0.01347369,-0.054768965,0.018893763,0.046726275,0.035055634,-0.01868614,-0.028761355,-0.048562106,0.037853092,0.012370005,-0.0077804276,-0.028258689,-0.022663774,-0.06066985,0.010310159,0.0048327167,-0.042683076,-0.014970766,0.013572038,-0.034072153,0.011222611,-0.02388766,0.02039084,0.018347384,-0.02474001,0.022303164,-0.051490694,-0.014784998,0.046901118,-0.06018904,0.031318408,-0.0070100343,-0.022084612,0.003996758,0.028936198,0.042508233,-0.003007813,0.007966196,-0.03763454,0.008851329,0.01760431,0.0027209641,0.0005183765,0.03022565,-0.0024873875,0.04589578,0.018904692,-0.0038492354,0.03558016,-0.029897822,-0.040847246,0.05848434,0.010206347,0.049960837,-0.011375597,-0.0135174,0.041240636,0.009654505,-0.06779463,-0.121514544,-0.060844693,0.025614217,-0.019877244,-0.052058928,0.0014861492,0.043404296,0.0472508,0.013124008,-0.0016773816,0.023188297,0.05044165,0.034771517,0.015560855,-0.004259019,0.0068297293,0.004898282,0.0842734,0.039732635,-0.0026075908,-0.05354