{"id":"697a20d9ed36a","content":"{\"questions\":\"Find consignment orders with pending entries count\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_main.id AS iSOMainID,\\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\tcustomers.company AS strCustomerName,\\n\\t\\t\\tCOUNT(s_order_consignment_pending.id) AS iPendingCount,\\n\\t\\t\\tSUM(s_order_consignment_pending.qty) AS iTotalPendingQty\\n\\t\\tFROM s_order_main\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tLEFT JOIN s_order_consignment_pending ON s_order_consignment_pending.s_order_main_id = s_order_main.id\\n\\t\\t\\t&& s_order_consignment_pending.is_deleted = 0\\n\\t\\tWHERE s_order_main.status = 'consignment'\\n\\t\\tGROUP BY s_order_main.id, s_order_main.order_no, customers.company\\n\\t\\tHAVING iPendingCount > 0\\n\\t\\tORDER BY iPendingCount DESC;\"}","embedding":[-0.018909024,0.028613433,-0.023282256,0.040983435,0.035173282,-0.017138906,0.043399125,0.035860505,-0.04071271,-0.006976347,0.03865104,-0.029904578,-0.019856557,0.016701583,-0.078759834,0.055394277,0.0012989541,0.05955926,-0.023053182,-0.027697138,0.005935101,0.05164579,0.05472788,0.0016555808,0.04419047,0.013536195,-0.020033568,0.0059923693,-0.020345943,0.0066327355,-0.010292714,0.036755975,0.04185808,-0.038796816,-0.049938146,0.004154571,-0.017899014,-0.01749293,-0.0012501457,-0.011599478,-0.012713611,-0.027822087,-0.03250769,0.0043133604,-0.029675504,-0.011995152,-0.004253489,-0.0062006186,-0.026468467,0.0051984196,0.0039254967,-0.026780842,-0.044107173,-0.0074292887,-0.019377584,0.00029106074,-0.011443291,-0.021782862,0.039463215,0.004339392,-0.05172909,-0.033507288,-0.01605601,0.026655892,-0.026635068,0.027572189,-0.034256987,0.018669536,0.041504055,-0.024094427,-0.019689959,-0.023407206,0.04177478,0.14044324,0.011724427,0.002424801,0.047230907,-0.03377801,0.050937742,0.020106455,-0.006804541,0.039900538,0.023532154,0.020273056,0.027551364,0.007986356,-0.045398317,-0.11195475,-0.034465235,-0.0008635