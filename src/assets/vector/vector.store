{"id":"697a20e147a83","content":"{\"questions\":\"Get total quantity sold per style\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_styles.style_id AS iStyleID,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\tstyles.sStyleName AS strStyleName,\\n\\t\\t\\tSUM(s_order_styles.so_qty) AS iTotalOrderedQty,\\n\\t\\t\\tSUM(s_order_styles.so_delivered_qty) AS iTotalDeliveredQty,\\n\\t\\t\\tSUM(s_order_styles.total_sales_price) AS fTotalSalesValue\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_styles.s_order_main_id\\n\\t\\tWHERE s_order_styles.cancel = 0\\n\\t\\t\\t&& s_order_main.status = 'order'\\n\\t\\tGROUP BY s_order_styles.style_id, styles.sStyleNo, styles.sStyleName\\n\\t\\tORDER BY iTotalOrderedQty DESC\\n\\t\\tLIMIT 20;\"}","embedding":[-0.035090648,-0.022328436,-0.015892977,0.049874812,0.05074447,-0.03095978,0.0010327174,0.046091806,-0.050092228,0.05165761,0.016056037,-0.005571238,0.036786478,0.006457201,-0.021393556,0.028655188,-0.027176773,0.023872077,-0.0022787724,0.0012480933,0.013360102,0.037308272,0.007174668,0.026894134,0.027046325,0.015892977,-0.012229548,0.001725725,0.005155434,-0.01687134,-0.022915455,-0.00015533224,0.035851598,-0.052483782,-0.034460146,-0.006196304,0.0075225304,0.00076910265,0.0065713436,-0.017567066,0.011229442,-0.0019146036,-0.0029405267,0.047178876,-0.02254585,-0.0076692854,0.023437249,0.030394502,-0.03743872,-0.077008106,0.028002946,0.04309149,-0.031242417,0.023567697,-0.018665006,-0.04159133,0.008446541,0.02023039,0.032873023,-0.007544272,-0.008952029,-0.034112286,-0.002670118,0.03987376,-0.054570958,0.005438072,-0.017045273,0.0830957,0.033068698,0.048222464,-0.008663955,-0.015577726,0.06370235,0.08618298,0.01578427,0.006440895,0.03830838,-0.04826595,0.004318389,0.06822457,-0.005614721,0.05796262,-0.051266264,0.008538942,-0.02163271,0.019393345,-0.06887681,-0.10957675,-0.03098152,-0.009664061,0.0015667409,-0.050700985,0.