{"id":"697a210a7fe11","content":"{\"type\":\"troubleshooting_pattern\",\"pattern\":\"Check Why User Not Receiving Emails\",\"description\":\"Steps to diagnose email delivery issues\",\"steps\":[\"1. Get user: User::Get($iUserID)\",\"2. Check email: $oUser->strEmail (uEmail) - is it valid?\",\"3. Check subscription: $oUser->bNewsletter (uNewsletter) - is it enabled?\",\"4. Check user active: $oUser->bIsDeleted (uis_deleted) should be 0\",\"5. Check maillog: SELECT * FROM maillog WHERE mlEmail = ? ORDER BY mlDate DESC\",\"6. Check mlSent and mlError for delivery status\"],\"search_terms\":[\"email not received\",\"newsletter problem\",\"mail issue\"]}","embedding":[0.017598184,0.024792533,-0.016184833,0.039750498,0.01486963,0.02371289,0.0025445225,0.017166326,-0.006153966,0.041890156,0.013937212,-0.05241177,-0.021808792,0.02524402,0.038415667,0.017637443,-0.02067026,0.009010113,-0.0077390783,0.00905428,0.015164079,0.057358496,0.019315798,0.054806612,-0.075889096,0.006904809,-0.004684179,-0.013858692,-0.025616989,-0.04236127,0.006090169,0.005167565,-0.013927396,-0.039220493,0.008877611,-0.044873897,-0.03833715,-0.010590318,-0.02208361,-0.03342968,-0.06360079,-0.084172904,0.018687641,-0.0075918543,-0.035196368,-0.010766987,0.015291673,-0.00511849,0.00042112218,0.015919829,0.009368358,-0.041261997,-0.050723597,0.041811634,0.028168872,-0.023300663,0.06497489,-0.015625382,0.0042719515,-0.042910907,-0.022319168,0.030387048,0.03621712,0.03492155,-0.01711725,0.025832916,-0.009628454,0.032624852,0.029542962,0.018756347,0.0038940767,0.036668606,0.006836104,-0.016547985,0.009147522,0.009255487,0.03973087,0.03321375,0.018893756,-0.013819433,0.001931089,0.006659435,0.023909189,-0.037355654,-0.017774852,0.0015397184,-0.023143623,-0.11463847,0.023909189,0.045227233,-0.046483546,-0.024714014,-0.041419037,-0.007577132,-0.024262527,-0.009746233,0.021278786,0.016989658,-0.024969202,0.03924012,0.07573206,-0.05225473,-0.061912626,0.016243722,0.06795863,0.03492155,0.055434767,0.0007201711,