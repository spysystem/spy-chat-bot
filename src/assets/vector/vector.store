{"id":"697a20e731559","content":"{\"questions\":\"Find all cancelled order styles\",\"answer\":\"\\t\\tSELECT\\n\\t\\t\\ts_order_main.id AS iSOrderID,\\n\\t\\t\\ts_order_main.order_no AS strOrderNo,\\n\\t\\t\\ts_order_styles.s_order_style_id AS iSOStyleID,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\ts_order_styles.so_qty AS iCancelledQty,\\n\\t\\t\\ts_order_styles.cancel_date AS dtCancelDate,\\n\\t\\t\\ts_order_styles.cancel_comment AS strCancelComment,\\n\\t\\t\\tcustomers.company AS strCustomerName\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_styles.s_order_main_id\\n\\t\\tINNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tWHERE s_order_styles.cancel = 1\\n\\t\\tORDER BY s_order_styles.cancel_date DESC;\"}","embedding":[-0.050043244,-0.0031809856,-0.016773438,0.09531234,0.012521467,0.008621164,0.0006713638,0.021973843,-0.05247294,0.030669602,0.02555445,-0.04731516,0.011914043,-0.008834295,-0.050384253,0.017274296,-0.050171122,0.04092122,-0.019416267,-0.008098992,0.03595526,0.05396486,0.035848696,-0.0024736559,0.031458188,0.05656506,-0.035358492,-0.00038696663,0.036914352,-0.02136642,-0.0019967745,0.011967326,0.049105465,-0.04403294,-0.06185072,-0.008216213,0.004576996,0.021068035,0.0041587255,0.0051950766,-0.032246776,-0.012478841,0.03182051,0.008173588,-0.043478798,0.0049233343,-0.0027760358,0.0031463515,-0.02962526,-0.031863138,0.026087279,0.038853846,-0.05980466,-0.01285182,0.018585054,-0.009974548,-0.027493944,-0.011679598,0.011903387,0.028836673,-0.077324055,-0.045269098,-0.0020540534,0.060486678,-0.025874147,0.043734554,-0.035166673,0.040153947,-0.012873134,0.023188692,-0.00023178034,-0.034292836,0.0222296,0.08069153,-0.021739399,0.009175305,0.026513541,-0.004542362,0.012969043,0.02610859,-0.003282223,0.020108944,-0.04650526,0.021973843,-0.024424853,0.02365758,-0.059080012,-0.12455396,-0.011700911,0.008312123,0.008791668