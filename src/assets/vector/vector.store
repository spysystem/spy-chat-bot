{"id":"697a20f060b40","content":"{\"DOC_TYPE\":\"query_example\",\"description\":\"WRONG WAY - styles table does NOT have color columns! This will fail with \\\"Unknown column\\\" error.\",\"query\":\"-- THIS IS WRONG AND WILL FAIL:\\n-- SELECT styles.sColorName FROM styles  -- ERROR: Unknown column 'styles.sColorName'\\n-- \\n-- CORRECT WAY: Join via styles_colors to color_master:\\nSELECT\\n\\tstyles.sId AS iStyleID,\\n\\tstyles.sStyleNo AS strStyleNo,\\n\\tcolor_master.color_name AS strColorName\\nFROM styles\\nINNER JOIN styles_colors ON styles_colors.scStyleId = styles.sId\\nINNER JOIN color_master ON color_master.color_master_id = styles_colors.color_master_id\"}","embedding":[0.0038257085,-0.024705542,-0.031612046,0.033999722,0.014089263,0.039071064,-0.014296458,0.0018906548,-0.067170665,-0.010784009,0.026363103,-0.0051946756,0.0073159584,-0.029086238,-0.045701306,0.055686135,-0.069301814,0.019427001,-0.036446597,0.034927167,0.019052079,0.0005768779,-0.022534927,0.064131804,0.01772011,0.024429282,0.026816959,0.03877507,-0.049490016,-0.019200075,0.033486668,-0.002760134,0.08493023,-0.014977242,-0.015401498,0.022179736,-0.039090797,0.029283566,0.02965849,0.032026436,0.03905133,-0.022791455,0.026816959,0.050673988,-0.012559966,0.014799646,-0.018706754,-0.0053081396,-0.02551459,-0.04242565,0.01730572,0.029263834,0.017956905,-0.033526134,0.016654536,-0.0071827616,-0.016131615,0.007878345,-0.051700097,0.04649062,-0.0961385,-0.00043998114,-0.0350061,0.026540698,-0.01182985,-0.00782408,0.028099595,-0.0017623912,0.0020904501,0.00613692,-0.01548043,0.004407828,0.0049011493,0.03555862,-0.0030141945,0.019081678,-0.000517371,-0.0068423697,-0.04068916,0.0050146133,-0.018627822,-0.02017685,-0.04668795,0.05627812,-0.03840015,-0.021054963,-0.025554055,-0.08003648,-0.043293897,-0.016023085,-0.0017771908,-0.05702797,0.046530087,-0.022751989,-0.0030709265,-0.006437846,0.0068621025,-0.0073356912,-0.052371014,0.013270349,0.006807837,-0.0038898403,-0.007192628,0.060461488,0.0939284