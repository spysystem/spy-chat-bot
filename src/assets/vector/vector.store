{"id":"697a20dbcd50a","content":"{\"questions\":\"Get consignment order with style details\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_main.id AS iSOMainID,\\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\ts_order_styles.s_order_style_id AS iSOStyleID,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\tstyles.sStyleName AS strStyleName,\\n\\t\\t\\ts_order_styles.qty AS iQty,\\n\\t\\t\\ts_order_styles.price AS fPrice\\n\\t\\tFROM s_order_main\\n\\t\\tINNER JOIN s_order_styles ON s_order_styles.s_order_main_id = s_order_main.id\\n\\t\\tINNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\tWHERE s_order_main.status = 'consignment'\\n\\t\\t\\t&& s_order_main.id = 123\\n\\t\\tORDER BY styles.sStyleNo;\"}","embedding":[-0.018860605,0.02007361,-0.021973625,0.04414047,0.013997854,0.0027936667,0.028317744,0.035896335,-0.07093391,0.026342586,0.0476614,-0.03961049,0.029541481,2.4026942e-5,-0.018645914,0.041929152,-0.021222206,0.05298574,-0.020492256,-0.03677657,0.0367551,0.051010583,0.05916884,-0.0033062415,0.022993406,0.01299954,0.0016826408,0.018903542,-0.0064675664,-0.027716609,-0.012720442,0.033577673,0.044784542,-0.039052293,-0.070976846,-0.0027560957,-0.004578286,0.03649747,-0.004256249,0.0033357614,0.0002705442,-0.040941574,0.00052901206,0.030808158,-0.021544242,0.022005828,0.012859991,0.027351635,-0.00023716647,-0.030013802,0.006966723,-0.018270204,-0.052212853,0.0068754796,0.00062595843,-0.009365895,-0.00094799494,0.012945867,0.02982058,-0.011282012,-0.05105352,-0.08042325,-0.0074819815,0.035982214,-0.04205797,0.032547157,-0.012849256,0.07054746,0.020105813,0.027051067,-0.019998467,-0.02245668,0.06230333,0.10511272,0.014953229,0.014609722,0.06835762,-0.01960129,0.014480908,0.023701888,0.008458826,0.03125901,-0.017958902,0.031409293,-0.01491029,0.019332925,-0.055003837,-0.11893882,-0.012559424,-0.006242141,-0.0062153046,-0.031860147,0.03456525,0.018055514,0.06792823,0.0069720903,-0.03677657,0.017497316,-0.034737006,0.006065021,0.026514338,-0.0