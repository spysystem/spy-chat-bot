{"id":"697a20e839020","content":"{\"questions\":\"Get cancelled quantity summary per order\",\"answer\":\"\\t\\tSELECT\\n\\t\\t\\ts_order_main.id AS iSOrderID,\\n\\t\\t\\ts_order_main.order_no AS strOrderNo,\\n\\t\\t\\tcustomers.company AS strCustomerName,\\n\\t\\t\\tCOUNT(s_order_styles.s_order_style_id) AS iCancelledStyleCount,\\n\\t\\t\\tSUM(s_order_styles.so_qty) AS iTotalCancelledQty\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_styles.s_order_main_id\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tWHERE s_order_styles.cancel = 1\\n\\t\\tGROUP BY s_order_main.id, s_order_main.order_no, customers.company\\n\\t\\tORDER BY iTotalCancelledQty DESC;\"}","embedding":[-0.033413757,-0.023070902,-0.017413992,0.08616232,0.033244893,-0.018754343,-0.013582914,0.03527125,-0.059819702,0.018764896,0.014226704,-0.018553818,-0.004683309,-0.016041981,-0.046986118,0.026574807,-0.066320926,0.01952478,-0.012253119,-0.0100579,0.03596781,0.062057137,0.04436874,-0.0057202326,0.043819938,0.034553584,-0.030564195,0.0018733235,0.026764778,-0.010807229,-0.022627637,0.011007754,0.0210551,-0.06459008,-0.06530775,-0.013213526,-0.00022608507,-0.022057723,0.013297958,-0.031176323,-0.027440231,0.02784128,0.010063177,0.03377259,-0.04052711,-0.01826886,-0.009820436,0.0022110494,-0.06564547,-0.034215856,0.037487578,0.018311078,-0.06332361,-0.0055197077,0.020548511,-0.019292593,0.010168716,-0.012390319,0.026764778,0.021973291,-0.04419988,-0.030564195,0.0055672005,0.048210375,-0.05876431,0.03653772,-0.026279299,0.04348221,-0.00017578897,0.028284546,-0.005841603,-0.03370927,0.025118364,0.08624676,-0.012031485,0.007762419,0.043819938,-0.029065536,0.03733982,0.04715498,-0.037994165,0.047999296,-0.06475894,0.01590478,-0.011218833,0.011524897,-0.0681362,-0.10131777,-0.03349819,-0.007878512,0.009598804,-0.052558597,0.034743555,-0.039809443,0.046521746,0.0273558,-0.0292344,0.010611981,-0.008121253,0.009203031,-0.0035039063,0.0040896