{"id":"697a20ec685a5","content":"{\"questions\":\"Get colors for a style - IMPORTANT: color is NOT in styles table, must join via styles_colors to color_master\",\"answer\":\"\\t\\tSELECT\\n\\t\\t\\tstyles.sId AS iStyleID,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\tstyles.sStyleName AS strStyleName,\\n\\t\\t\\tstyles_colors.scId AS iStyleColorID,\\n\\t\\t\\tcolor_master.color_master_id AS iColorMasterID,\\n\\t\\t\\tcolor_master.color_name AS strColorName\\n\\t\\tFROM styles\\n\\t\\tINNER JOIN styles_colors ON\\n\\t\\t\\tstyles_colors.scStyleId = styles.sId\\n\\t\\tINNER JOIN color_master ON\\n\\t\\t\\tcolor_master.color_master_id = styles_colors.color_master_id\\n\\t\\tWHERE\\n\\t\\t\\tstyles.sStyleNo = 'STYLE123'\\n\\t\\tORDER BY\\n\\t\\t\\tcolor_master.color_name ASC;\"}","embedding":[-0.03648154,-0.0039492203,-0.03446403,0.029118676,0.03367367,0.03650234,0.011824262,0.012240243,-0.049959328,0.0039882185,0.02179741,-0.016420852,0.029971438,0.018396763,-0.0038842233,0.03845745,-0.037500694,0.003429244,-0.019852698,0.012614626,0.022941357,-0.019665506,-0.0061513204,0.04505075,-0.0024516885,0.029368265,0.02177661,0.0055793463,-0.00901119,-0.018646352,0.010009545,0.005672942,0.05657343,-0.0658498,-0.07932759,-0.021693414,-0.021839008,0.036585536,0.019155929,0.0615652,-0.0013753375,-0.06027566,0.06439387,0.021069441,-0.0099315485,0.0018394163,-0.0035436389,0.0011140493,-0.009026789,-0.06830409,0.016327258,0.025208453,-0.021839008,-0.03579517,0.016764037,-0.034630425,-0.02597802,0.035108805,-0.0064529064,0.023461333,-0.036855925,-0.009115186,-0.023981309,0.0330081,-0.026352402,-0.008813599,-0.0285987,0.033590473,0.003715231,0.048045814,-0.003143257,7.1171766e-5,0.04596591,0.06331232,-0.00549615,0.07188153,0.027953928,0.0011575974,-0.04525874,0.04534194,-0.008252025,0.0044067996,-0.016774436,0.042346876,-0.054451924,-0.008090832,-0.021589419,-0.10191537,0.0025582837,-0.0051581655,-0.0050437707,-0.032592118,0.0857753,0.0023138947,0.04442678,0.0026102813,-0.03926