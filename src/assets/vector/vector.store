{"id":"697a20eee037c","content":"{\"DOC_TYPE\":\"query_example\",\"description\":\"Get sales order details with style and color information\",\"query\":\"SELECT\\n\\ts_order_main.order_no AS iOrderNo,\\n\\ts_order_main.id AS iSOMainID,\\n\\tstyles.sStyleNo AS strStyleNo,\\n\\tstyles.sStyleName AS strStyleName,\\n\\tcolor_master.color_name AS strColorName,\\n\\ts_order_styles.so_qty AS iOrderedQty,\\n\\ts_order_styles.so_delivered_qty AS iDeliveredQty\\nFROM s_order_main\\nINNER JOIN s_order_styles ON\\n\\ts_order_styles.s_order_main_id = s_order_main.id\\nINNER JOIN styles ON\\n\\tstyles.sId = s_order_styles.style_id\\nINNER JOIN s_order_style_seasons ON\\n\\ts_order_style_seasons.s_order_style_id = s_order_styles.s_order_style_id\\nINNER JOIN s_order_style_colors ON\\n\\ts_order_style_colors.s_order_style_season_id = s_order_style_seasons.id\\nINNER JOIN styles_colors ON\\n\\tstyles_colors.scId = s_order_style_colors.style_color_id\\nINNER JOIN color_master ON\\n\\tcolor_master.color_master_id = styles_colors.color_master_id\\nWHERE\\n\\ts_order_main","embedding":[-0.013180931,0.015603319,-0.020555975,0.05590127,0.0258715,0.020948265,0.018064937,0.013465341,-0.05970648,0.03707137,0.044564098,-0.030873192,0.030108228,0.0048374212,-0.03201083,0.070455216,-0.035521824,0.002493491,-0.035443366,-0.00042048542,0.061707154,0.06743459,0.05276295,0.04217113,0.026558006,0.02057559,0.0073652375,0.030520132,-0.008071358,0.013014208,0.0086646965,-0.0011799335,0.06151101,-0.04236728,-0.032716952,0.03558067,-0.038503226,-0.0003625614,0.054214425,0.0045726257,0.02981401,-0.030912422,0.03742443,0.0018695052,-0.017466694,0.0648847,0.01808455,0.031618543,-0.007379948,-0.08418535,0.025498824,0.0029004912,-0.0061001033,-0.005021307,0.011180254,-0.011415628,0.027597575,0.06931757,-0.028519455,-0.018339539,-0.04530945,-0.022164363,0.011817724,0.029225577,-0.024204269,-0.009179577,0.035796426,0.033070013,-0.008257696,0.015044306,-0.01225905,0.0034300822,0.029774781,0.06319786,-0.017172478