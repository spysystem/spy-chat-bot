{"id":"697a20e317375","content":"{\"questions\":\"Get sales by style and brand\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\tbrands.dpId AS iBrandID,\\n\\t\\t\\tbrands.dpName AS strBrandName,\\n\\t\\t\\ts_order_styles.style_id AS iStyleID,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\tSUM(s_order_styles.so_qty) AS iTotalQty,\\n\\t\\t\\tSUM(s_order_styles.total_sales_price) AS fTotalSales\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\tINNER JOIN brands ON brands.dpId = s_order_styles.brand_id\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_styles.s_order_main_id\\n\\t\\tWHERE s_order_styles.cancel = 0\\n\\t\\t\\t&& s_order_main.status = 'order'\\n\\t\\tGROUP BY brands.dpId, brands.dpName, s_order_styles.style_id, styles.sStyleNo\\n\\t\\tORDER BY fTotalSales DESC\\n\\t\\tLIMIT 20;\"}","embedding":[-0.035953794,-0.004051403,-0.007954282,0.05619706,0.05179635,-0.040596545,-0.0055421432,0.02816454,-0.01928611,0.06376628,0.030034842,-0.040112466,0.047967732,-0.008982948,-0.04081658,0.055756986,-0.03425952,0.03238922,-0.0065900623,-0.0049728015,0.013928245,0.002108215,0.003275778,0.025612129,0.006133489,0.023719823,-0.006546055,0.019253103,0.0167557,0.0003506815,-0.013719211,0.01067172,0.052192412,-0.045327306,-0.055140886,-0.024181899,-0.009566042,0.031069009,0.018163927,0.028582606,0.019055072,-0.018130923,-0.01104578,0.04862784,-0.02772447,-0.00018703015,0.010369171,0.018130923,-0.025040036,-0.09558341,0.019638166,0.035557732,-0.042884912,0.0076132272,-0.028406579,-0.035755765,-0.0065845614,0.02015525,0.014434326,0.008768413,-0.032103173,-0.01184891,-0.02922071,0.043963086,-0.04845181,-0.010501193,-0.006793595,0.063634254,0.039738405,0.028252553,0.0033692932,-0.020958379,0.078816704,0.08216124,0.01283907,0.016590673,0.044095106,-0.034941632,0.009219486,0.05192837,0.018956056,0.051444292,-0.022014549,0.0071511525,0.0059574605,0.014709371,-0.04677954,-0.13017298,-0.016612677,0.006171995,0.027702466,-0.04