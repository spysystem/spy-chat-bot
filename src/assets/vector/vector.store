{"id":"697a20ee51b2c","content":"{\"DOC_TYPE\":\"query_example\",\"description\":\"Retrieves all order lines for a sales order, including style number, style name, color, size, ordered quantity, and delivered quantity.\",\"query\":\"SELECT s_order_main.order_no                   AS iOrderNo,\\n\\t   styles.sStyleNo                         AS strStyleNo,\\n\\t   styles.sStyleName                       AS strStyleName,\\n\\t   color_master.color_name                 AS strColorName,\\n\\t   sizesets_sizes.szsName                  AS strSizeName,\\n\\t   s_order_style_sizesets.so_qty           AS iOrderedQty,\\n\\t   s_order_style_sizesets.so_delivered_qty AS iDeliveredQty\\nFROM s_order_main\\n\\t\\t INNER JOIN s_order_styles ON s_order_styles.s_order_main_id = s_order_main.id\\n\\t\\t INNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\t INNER JOIN s_order_style_seasons ON s_order_style_seasons.s_order_style_id = s_order_styles.s_order_style_id\\n\\t\\t INNER JOIN s_order_style_colors ON s_order_style_colors","embedding":[-0.0033268312,0.029954053,-0.019533504,0.06119559,0.02220905,0.027600378,0.019060757,0.035124097,-0.058178056,0.0501313,0.03081908,-0.019724613,0.013749897,0.019795023,-0.03510398,0.080185935,-0.038322683,0.0077349455,-0.03142259,0.001919906,0.067632996,0.081553884,0.04305015,0.064856865,0.037960578,0.020499114,0.002836482,0.020277828,0.009771781,-0.036290877,0.0155604165,0.0183969,0.04494114,-0.02480413,-0.024381675,0.017733041,-0.016536087,-0.005336006,0.055764027,0.0025460443,-0.011024058,-0.035828188,0.015429657,0.02375805,-0.023295362,0.04079706,0.01230148,0.033192873,-0.0127842855,-0.059586238,0.031503055,0.019986134,-0.031100716,-0.018437132,-0.01599293,-0.020800868,0.047958672,0.068719305,0.015510125,0.004571564,-0.0679951,-0.041521266,0.0183969,0.02544787,-0.036109824,-0.027097456,0.027298624,0.046510257,0.0056478176,0.014383579,-0.003160867,-0.0085295625,0.039932035,0.03665298,-0.020941686,0.039388876,0.02130379,-0.0504934,0.0