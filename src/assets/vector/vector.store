{"id":"697a20e0a2789","content":"{\"questions\":\"Get all styles on a specific order\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_styles.s_order_style_id AS iSOrderStyleID,\\n\\t\\t\\ts_order_styles.style_id AS iStyleID,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\tstyles.sStyleName AS strStyleName,\\n\\t\\t\\ts_order_styles.so_qty AS iOrderedQty,\\n\\t\\t\\ts_order_styles.so_delivered_qty AS iDeliveredQty,\\n\\t\\t\\ts_order_styles.sales_price AS fSalesPrice,\\n\\t\\t\\ts_order_styles.sales_discount_percentage AS fDiscountPct,\\n\\t\\t\\ts_order_styles.total_sales_price AS fTotalSalesPrice,\\n\\t\\t\\ts_order_styles.status AS strStatus\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\tWHERE s_order_styles.s_order_main_id = 123\\n\\t\\t\\t&& s_order_styles.cancel = 0\\n\\t\\tORDER BY styles.sStyleNo;\"}","embedding":[-0.0512023,0.03202242,-0.022747252,0.04696342,0.030616457,-0.0033234279,0.030028889,0.034540568,-0.061232913,0.03976572,0.010382106,-0.02518146,0.04219993,0.0336802,-0.0036172117,0.041402515,-0.03510715,0.0140806325,-0.016588286,-0.010460798,0.032609988,0.041948114,0.020407474,0.008042328,0.013262235,0.032316204,-0.007292131,0.0024512575,0.016032195,-0.03198045,-0.008682357,0.00086757995,0.034288753,-0.03496026,-0.054685734,-0.011793316,-0.0034913043,0.020334028,0.0024656844,0.002751599,-0.015528566,-0.032463096,0.044529215,0.048600215,-0.019389722,0.006447503,0.01909594,0.027573697,-0.025580166,-0.039429966,0.041402515,0.019316278,-0.047718864,0.0024263384,0.0059805964,-0.03248408,-0.0025784764,0.010282429,0.034981243,-0.0019830398,-0.068073876,-0.05481164,0.0027174992,0.05388832,-0.044948906,0.009820769,-0.013734387,0.08603665,-0.0011528387,0.035778657,0.0053012217,-0.022054762,0.03869551,0.08486152,-0.019337263,0.026629392,0.055189364,-0.023691555,0.023964355,0.022747252,0.010371613,0.044361338,-0.048138555,0.0065524257,-0.03344937,0.02694416,-0.054224074,-0.1052585,0.00019017248,0.007176