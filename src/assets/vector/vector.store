{"id":"697a20e47af69","content":"{\"questions\":\"Find order styles with claims\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_styles.s_order_style_id AS iSOrderStyleID,\\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\ts_order_styles.claims_type AS strClaimsType,\\n\\t\\t\\ts_order_styles.claims_id AS iClaimsID,\\n\\t\\t\\ts_order_styles.so_qty AS iQty,\\n\\t\\t\\tcustomers.company AS strCustomerName\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_styles.s_order_main_id\\n\\t\\tINNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tWHERE s_order_styles.claims_id > 0\\n\\t\\tORDER BY s_order_styles.added_date DESC\\n\\t\\tLIMIT 50;\"}","embedding":[-0.033499762,0.028327169,-0.014951684,0.04550995,0.014552085,0.003626921,0.034165762,0.02810517,-0.06455753,0.05669874,0.043911554,-0.037762158,0.040004358,-0.0030247467,-0.01898098,0.042468555,-0.03467636,0.035075963,-0.021489577,-0.012098987,0.01768228,0.042313155,0.010439538,0.0017468606,0.03762896,0.033788364,-0.015773082,0.0070595923,-0.020668177,-0.032500766,-0.010051039,0.022976976,0.02666217,-0.052258745,-0.06704393,0.0017940355,0.016383583,-0.011599488,0.026861971,0.039715756,-0.0069652423,-0.04531015,0.020612678,0.014263485,-0.013719585,-0.010939038,0.016638882,0.009928939,-0.016072782,-0.04595395,0.037584558,0.033366565,-0.049994346,-0.025130372,-0.030991167,-0.02759457,-0.014518784,-0.004545445,0.023887174,-0.010239739,-0.060117535,-0.008075241,-0.0012952299,0.05434554,-0.006671093,0.011410788,-0.016849782,0.05461194,0.01818178,0.032212164,0.014785184,-0.03563096,0.03578636,0.10638229,0.0015886858,0.04497715,0.02743917,-0.024997173,0.022222176,0.019924479,0.030058768,0.02746137,-0.026018372,0.022888176,0.022976976,0.03762896,-0.04564315,-0.13026945,-0.012409787,-0.022510776,0.013164585,-0.059540335,0.047463547,0.0059273937,0.049150746,0.02