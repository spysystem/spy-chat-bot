{"id":"697a20e659647","content":"{\"questions\":\"Get the customer with the larget order\",\"answer\":\"\\t\\tSELECT\\n\\t\\t\\ts_order_main.customer_id   AS iCustomerId,\\n\\t\\t\\tcustomers.company          AS strCustomerName,\\n\\t\\t\\ts_order_main.id            AS iSOMainId,\\n\\t\\t\\ts_order_main.order_no      AS iOrderNo,\\n\\t\\t\\tSUM(s_order_styles.so_qty) AS iTotalQty\\n\\t\\tFROM s_order_main\\n\\t\\t\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\t\\t\\tINNER JOIN s_order_styles ON s_order_styles.s_order_main_id = s_order_main.id\\n\\t\\tWHERE s_order_main.status = 'order'\\n\\t\\tGROUP BY s_order_main.id, s_order_main.order_no, s_order_main.customer_id, customers.company\\n\\t\\tORDER BY iTotalQty DESC\\n\\t\\tLIMIT 1;\"}","embedding":[-0.021555379,0.017570077,-0.0074710837,0.063721396,0.019568158,-0.011793018,0.030275263,0.036616996,-0.04912672,0.06198393,0.02467195,-0.048822664,-0.016332136,-0.02180514,-0.024780542,0.024367895,-0.039266624,0.0036350947,-0.04521743,-0.022326378,0.04569523,0.037159953,0.04821455,0.0187863,0.030948529,0.0375726,0.008247511,0.0010947364,0.017939288,-0.01416031,-0.0024690954,0.04547805,0.024976006,-0.07275619,-0.016592756,-0.044522446,-0.0026143363,-0.0060431077,0.010337895,0.009740642,0.03294661,-0.0059725232,0.011619273,0.028581237,-0.004997916,0.00613541,-0.02116445,0.023846656,-0.030861655,-0.02593161,0.023759782,-0.014800998,-0.09920904,-0.011684427,-0.027842818,-0.017602654,-0.0049653384,-0.014442647,0.044044644,0.0044658184,-0.04219859,-0.019937368,-0.0013533195,0.029927772,-0.029406533,-0.004522829,-0.029667152,0.0719309,0.026561439,0.041004088,0.01315041,0.0070584365,0.048909534,0.08153037,-0.00090402283,0.020491185,0.07453709,-0.07423303,0.020132832,0.031773824,0.02491085,0.05898681,-0.0022614144,0.015702307,0.053426936,-0.00090402283,-0.0638517,-0.1199717,-0.022239504,-0.023412291,-0.0022342666,-0.016929388,0.02117531,0.037811503,0.043501686,0.020143691,-0.042828422,0.020491185,-0.