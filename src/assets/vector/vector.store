{"id":"697a20d8ac284","content":"{\"questions\":\"Find consignment orders for a specific customer by name\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_main.id AS iSOMainID,\\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\ts_order_main.added_date AS dtAddedDate,\\n\\t\\t\\ts_order_main.status AS strOrderStatus,\\n\\t\\t\\tcustomers.id AS iCustomerId,\\n\\t\\t\\tcustomers.company AS strCustomerName\\n\\t\\tFROM s_order_main\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tWHERE customers.company LIKE '%CUSTOMER_SEARCH%'\\n\\t\\t\\t&& s_order_main.status = 'consignment'\\n\\t\\tORDER BY s_order_main.added_date DESC;\"}","embedding":[0.017745774,0.02975375,-0.02184702,0.057299137,-0.00039435056,0.010775629,0.019983714,0.024114536,-0.08446989,0.04053924,0.03900127,-0.0400463,-0.028215783,-0.009641871,-0.056510434,0.052448623,-0.015517695,0.038468897,-0.029970642,-0.01740072,0.022517417,0.046691105,0.057220265,-0.008552478,0.045113705,0.023996232,-0.008808806,0.008586983,0.02655951,-0.019421766,-0.01682891,0.04688828,0.057535745,-0.038804095,-0.039829407,-0.03310573,-0.02265544,0.008345444,-0.02090058,0.017420435,0.013398061,-0.025179284,-0.024430018,0.010460149,-0.029162224,0.003837524,-0.0067779003,0.025080696,0.01084464,-0.0015059263,0.024745498,-0.03906042,-0.08376006,-0.021354083,0.019017555,0.014719134,0.0038227357,-0.031074824,0.04290534,-0.0054814727,-0.07181124,-0.06207078,-0.00082628767,0.01603035,-0.00837009,0.030660756,-0.026362335,0.06207078,0.025238436,0.016483853,0.014906451,0.0015367349,0.045508053,0.109077364,-0.02870872,0.0031893102,0.052133143,-0.03229731,0.035609856,0.01499518,0.04164342,0.021156907,0.05990185,0.05430207,0.03886325,0.0018090832,-0.06321439,-0.11262652,-0.03334234,-0.012698088,0.0037709773,-0.014285349,0.03420991,0.012007974,0.053907722,0.012303737,-0.028274935,0.013772693,0.0027604538,0.054735858,-0.009400331,-0.03164663,-0.015458542,0.047992464,0.059468064,0.014305066,0.010174245,-0.012185432,