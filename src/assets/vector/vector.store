{"id":"697a20e19da12","content":"{\"questions\":\"Find canceled style lines on orders\",\"answer\":\"\\t\\tSELECT \\n\\t\\t\\ts_order_styles.s_order_style_id AS iSOrderStyleID,\\n\\t\\t\\ts_order_main.order_no AS iOrderNo,\\n\\t\\t\\tstyles.sStyleNo AS strStyleNo,\\n\\t\\t\\ts_order_styles.so_qty AS iCancelledQty,\\n\\t\\t\\ts_order_styles.cancel_comment AS strCancelComment,\\n\\t\\t\\ts_order_styles.cancel_date AS dtCancelDate,\\n\\t\\t\\tcustomers.company AS strCustomerName\\n\\t\\tFROM s_order_styles\\n\\t\\tINNER JOIN s_order_main ON s_order_main.id = s_order_styles.s_order_main_id\\n\\t\\tINNER JOIN styles ON styles.sId = s_order_styles.style_id\\n\\t\\tINNER JOIN customers ON customers.id = s_order_main.customer_id\\n\\t\\tWHERE s_order_styles.cancel = 1\\n\\t\\tORDER BY s_order_styles.cancel_date DESC\\n\\t\\tLIMIT 50;\"}","embedding":[-0.06697557,-0.0073698987,-0.020137925,0.07361279,0.018575592,-0.0013441445,-0.015095362,0.037926964,-0.042947978,0.0420429,0.010613085,-0.03180693,-0.0050964355,0.00641095,-0.051115204,0.014869094,-0.0694322,0.04174121,-0.016819315,-0.022217443,0.048917163,0.049994633,0.00940093,0.026936764,0.0512445,0.058571298,-0.0402112,0.002346192,0.03952162,-0.037452877,-0.0019259786,0.011399639,0.043034174,-0.05701974,-0.06857023,-0.019383695,0.022411387,0.01337141,0.021851104,0.025105065,-0.037129637,-0.04439179,0.026268732,0.016409876,-0.018015308,0.0007286395,0.0040324335,0.0063463016,-0.025083514,-0.045167565,0.035297934,0.026591973,-0.047020815,-0.03370328,0.0016795072,-0.012390912,-0.028100433,-0.017756715,0.018931158,0.032690458,-0.07387138,-0.027281554,0.0008808322,0.057235237,-0.025902392,0.042710934,-0.032453414,0.036871042,0.010397591,0.013543805,-0.006750353,-0.026721269,0.025105065,0.086542435,-0.019545317,0.0003592691,0.037495974,-0.0113673145,0.00080136873,0.019060453,-0.0045630876,0.021948075,-0.0621916,0.039737113,-0.002688289,0.01263873,-0.051718585,-0.12300404,-0.022411387,-0.007994832,0.021527862,-0.037215833,0.054950